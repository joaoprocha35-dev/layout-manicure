{
  "name": "vilma-delmiro-site",
  "version": "1.0.0",
  "description": "Site da Vilma Delmiro — HTML, SCSS, JS e GSAP",
  "scripts": {
    "build:css": "sass scss/main.scss css/main.css --style=compressed --no-source-map",
    "watch:css": "sass --watch scss/main.scss css/main.css --style=expanded",
    "vendor": "node -e \"for (const f of ['gsap','ScrollTrigger','ScrollSmoother']) require('fs').copyFileSync('node_modules/gsap/dist/'+f+'.min.js','js/vendor/'+f+'.min.js')\"",
    "build": "npm run vendor && npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "puppeteer-core": "^25.16.0",
    "sass": "^1.108.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  },
  "private": true
}
